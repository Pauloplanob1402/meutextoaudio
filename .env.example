# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...          # só no servidor, nunca com NEXT_PUBLIC_

# --- Mercado Pago (Suas integrações > sua aplicação) ---
MP_ACCESS_TOKEN=APP_USR-...                # credencial de PRODUÇÃO (ou de teste, para testar)
MP_WEBHOOK_SECRET=...                      # Webhooks > Configurar notificações > assinatura secreta

# --- Cobrança ---
PRO_PRICE_BRL=29.90                        # preço mensal do plano Criador, em reais. Sem isso, a assinatura fica "ainda não disponível"
SITE_URL=https://seudominio.com.br         # endereço público do site (precisa ser https em produção)

# --- Segurança (opcionais) ---
# Anti-robô no login (Cloudflare Turnstile). Crie em dash.cloudflare.com > Turnstile e cole a chave do SITE aqui.
# A chave SECRETA do Turnstile vai só no painel do Supabase (Authentication > Attack Protection).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Deixe vazio para o CSP só avisar (modo relatório). Troque por "enforce" para ele bloquear de verdade.
CSP_MODE=
