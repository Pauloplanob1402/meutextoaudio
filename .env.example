# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...          # só no servidor, nunca com NEXT_PUBLIC_

# --- Mercado Pago (Suas integrações > sua aplicação) ---
MP_ACCESS_TOKEN=APP_USR-...                # credencial de PRODUÇÃO (ou de teste, para testar)
MP_WEBHOOK_SECRET=...                      # Webhooks > Configurar notificações > assinatura secreta

# --- Cobrança ---
PRO_PRICE_BRL=19                           # preço mensal em reais. Sem isso, o plano Pro fica "Em breve"
SITE_URL=https://seudominio.com.br         # endereço público do site (precisa ser https em produção)
