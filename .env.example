# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...          # só no servidor, nunca com NEXT_PUBLIC_

# --- Mercado Pago (Suas integrações > sua aplicação) ---
MP_ACCESS_TOKEN=APP_USR-...                # credencial de PRODUÇÃO (ou de teste, para testar)
MP_WEBHOOK_SECRET=...                      # Webhooks > Configurar notificações > assinatura secreta

# --- Cobrança ---
PRO_PRICE_BRL=39.90                        # preço mensal do plano Criador, em reais. Sem isso, a assinatura fica "ainda não disponível"
PRO_ANNUAL_PRICE_BRL=399.00               # (opcional) preço do plano anual, em reais. Sem isso, usa 10x o mensal (2 meses grátis)
SITE_URL=https://seudominio.com.br         # endereço público do site (precisa ser https em produção)

# --- E-mail de boas-vindas do plano Criador (Brevo) ---
# Chave da API v3 do Brevo: SMTP e API > Chaves de API. NÃO é a chave SMTP usada no Supabase.
BREVO_API_KEY=xkeysib-...
# Remetente (precisa ser um remetente validado no Brevo). Se vazio, usa contato@sauim.com.br
EMAIL_FROM=contato@sauim.com.br
EMAIL_FROM_NAME=Sauim

# --- Segurança (opcionais) ---
# Anti-robô no login (Cloudflare Turnstile). Crie em dash.cloudflare.com > Turnstile e cole a chave do SITE aqui.
# A chave SECRETA do Turnstile vai só no painel do Supabase (Authentication > Attack Protection).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Deixe vazio para o CSP só avisar (modo relatório). Troque por "enforce" para ele bloquear de verdade.
CSP_MODE=

# Pacote do vídeo (legenda e capítulos junto com o áudio). Fica ligado por padrão; use 0 para desligar.
NEXT_PUBLIC_PACOTE=
